<Window x:Class="Vanta.App.BatchPlanDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Ui061}" Width="510" SizeToContent="Height" MinWidth="390" MaxHeight="680" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F5F8">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<TextBlock Text="{DynamicResource Ui062}" FontSize="22" FontWeight="SemiBold"/>
<TextBlock x:Name="SourceInfo" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="#526071"/>
<TextBlock Text="{DynamicResource Ui063}"/><ComboBox x:Name="CodecBox" SelectionChanged="OnChanged" Margin="0,3,0,10"/>
<TextBlock Text="{DynamicResource Ui011}"/><ComboBox x:Name="PresetBox" SelectionChanged="OnChanged" Margin="0,3,0,6"/><TextBlock Text="{DynamicResource Ui068}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,10"/>
<TextBlock Text="{DynamicResource Ui064}"/><ComboBox x:Name="HeightChoicesBox" ToolTip="{DynamicResource Ui014}" SelectionChanged="OnQuickHeight"/><TextBox x:Name="HeightBox" TextChanged="OnChanged" Margin="0,3,0,10"/>
<TextBlock Text="{DynamicResource Ui016}"/><ComboBox x:Name="RateChoicesBox" ToolTip="{DynamicResource Ui017}" SelectionChanged="OnQuickRate"/><TextBox x:Name="RateBox" TextChanged="OnChanged" Margin="0,3,0,10"/>
<Button x:Name="MoreCompressionButton" Content="{DynamicResource Ui019}" IsEnabled="False" Click="OnMoreCompression" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource Ui065}"/><DockPanel Margin="0,3,0,10"><Button DockPanel.Dock="Right" Content="{DynamicResource Ui022}" Click="OnTarget" Padding="8,5" Margin="8,0,0,0"/><TextBox x:Name="TargetBox"/></DockPanel>
<Border Background="White" BorderBrush="#D8DFE7" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel><TextBlock x:Name="Estimate" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Ui066}" Foreground="#526071" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
<WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{DynamicResource Ui029}" IsCancel="True" Padding="14,8" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="{DynamicResource Ui067}" Click="OnApply" IsDefault="True" IsEnabled="False" Padding="14,8"/></WrapPanel>
</StackPanel></ScrollViewer></Window>