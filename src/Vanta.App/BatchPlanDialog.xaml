<Window x:Class="Vanta.App.BatchPlanDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VANTA · Individual video settings" Width="510" SizeToContent="Height" MinWidth="390" MaxHeight="680" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F5F8">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<TextBlock Text="Individual video settings" FontSize="22" FontWeight="SemiBold"/>
<TextBlock x:Name="SourceInfo" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="#526071"/>
<TextBlock Text="Codec"/><ComboBox x:Name="CodecBox" SelectionChanged="OnChanged" Margin="0,3,0,10"/>
<TextBlock Text="Preset"/><ComboBox x:Name="PresetBox" SelectionChanged="OnChanged" Margin="0,3,0,10"/>
<TextBlock Text="Output height (even pixels, no upscaling)"/><TextBox x:Name="HeightBox" TextChanged="OnChanged" Margin="0,3,0,10"/>
<TextBlock Text="Video bitrate (kbps)"/><TextBox x:Name="RateBox" TextChanged="OnChanged" Margin="0,3,0,10"/>
<TextBlock Text="Optional target size budget (MB)"/><DockPanel Margin="0,3,0,10"><Button DockPanel.Dock="Right" Content="Apply target" Click="OnTarget" Padding="8,5" Margin="8,0,0,0"/><TextBox x:Name="TargetBox"/></DockPanel>
<Border Background="White" BorderBrush="#D8DFE7" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel><TextBlock x:Name="Estimate" TextWrapping="Wrap"/><TextBlock Text="Original audio and frame timing are preserved. Size and quality are not guaranteed. This override is kept when the shared profile or codec changes." Foreground="#526071" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
<WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" IsCancel="True" Padding="14,8" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="Use these settings" Click="OnApply" IsDefault="True" IsEnabled="False" Padding="14,8"/></WrapPanel>
</StackPanel></ScrollViewer></Window>