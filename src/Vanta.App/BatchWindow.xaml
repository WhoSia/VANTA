<Window x:Class="Vanta.App.BatchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Ui033}" Width="1180" Height="780" MinWidth="720" MinHeight="580" WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" Background="#E9EDF2" FontFamily="Segoe UI" FontSize="13">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#14243B" BorderBrush="#E4AC56" BorderThickness="0,0,0,3" CornerRadius="9" Padding="14,9" Margin="0,0,0,10"><StackPanel><DockPanel><ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="104" SelectionChanged="OnLanguage" AutomationProperties.Name="Language / 언어"><ComboBoxItem Content="English"/><ComboBoxItem Content="한국어"/></ComboBox><StackPanel Orientation="Horizontal"><TextBlock Text="VANTA / 02" FontSize="22" FontWeight="Bold" Foreground="#F9FAFB"/><TextBlock Text="{DynamicResource Ui034}" Margin="12,5,0,0" Foreground="#F4C578" FontWeight="SemiBold"/></StackPanel></DockPanel><TextBlock Text="{DynamicResource Ui035}" TextWrapping="Wrap" Foreground="#BECBDD" Margin="0,4,0,0"/></StackPanel></Border>
<StackPanel Grid.Row="1" Margin="0,0,0,12"><WrapPanel Margin="0,0,0,10"><Button x:Name="AddButton" Content="{DynamicResource Ui036}" Click="OnAdd" Padding="12,7" Margin="0,0,8,0"/><Button x:Name="ClearButton" Content="{DynamicResource Ui037}" Click="OnClear" Padding="12,7" Margin="0,0,12,0"/><Button x:Name="BatchSpeedButton" Content="{DynamicResource Ui087}" IsEnabled="False" Click="OnBatchSpeed" Background="#F4C578" Foreground="#192D47" BorderBrush="#C68F3E" Padding="10,7" Margin="0,0,6,4" ToolTip="{DynamicResource Ui089}"/><Button x:Name="BatchHevcButton" Content="{DynamicResource Ui088}" IsEnabled="False" Click="OnBatchHevc" Padding="10,7" Margin="0,0,8,4" ToolTip="{DynamicResource Ui089}"/><TextBlock Text="{DynamicResource Ui038}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#526071"/></WrapPanel><WrapPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{DynamicResource Ui039}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ProfileBox" AutomationProperties.Name="{DynamicResource Ui039}" Width="112" Margin="0,0,16,0" SelectionChanged="OnProfile"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{DynamicResource Ui040}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="RecommendationBox" AutomationProperties.Name="{DynamicResource Ui040}" Width="165" Margin="0,0,16,0" SelectionChanged="OnProfile"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{DynamicResource Ui070}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="SharedPresetBox" AutomationProperties.Name="{DynamicResource Ui070}" Width="144" Margin="0,0,16,0" ToolTip="{DynamicResource Ui068}" SelectionChanged="OnProfile"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{DynamicResource Ui041}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ParallelBox" AutomationProperties.Name="{DynamicResource Ui041}" Width="60" Margin="0,0,12,0" SelectionChanged="OnResourceSettings"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{DynamicResource Ui042}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ThreadsBox" AutomationProperties.Name="{DynamicResource Ui042}" Width="155" SelectionChanged="OnResourceSettings"/></StackPanel></WrapPanel></StackPanel>

<DockPanel Grid.Row="2" LastChildFill="True"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"><TextBlock Text="{DynamicResource Ui077}" VerticalAlignment="Center" Foreground="#526071" Margin="0,0,8,0"/><Button x:Name="QueueFirstButton" Content="{DynamicResource Ui078}" Click="OnQueueFirst" IsEnabled="False" Padding="8,4" Margin="0,0,4,0" ToolTip="{DynamicResource Ui081}"/><Button x:Name="QueueUpButton" Content="{DynamicResource Ui079}" Click="OnQueueUp" IsEnabled="False" Padding="8,4" Margin="0,0,4,0" ToolTip="{DynamicResource Ui081}"/><Button x:Name="QueueDownButton" Content="{DynamicResource Ui080}" Click="OnQueueDown" IsEnabled="False" Padding="8,4" ToolTip="{DynamicResource Ui081}"/></WrapPanel><DataGrid x:Name="Queue" CanUserSortColumns="False" AutomationProperties.Name="{DynamicResource Ui073}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OnQueueSelection" RowHeaderWidth="0" Background="White" AlternatingRowBackground="#F3F6FA" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DFE6EF" BorderBrush="#CBD5E1" RowHeight="34" ColumnHeaderHeight="32"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E1E8F0"/><Setter Property="Foreground" Value="#172C44"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,5"/></Style></DataGrid.ColumnHeaderStyle>
<DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Paths}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Ui046}" Binding="{Binding InputName}" Width="2*"/><DataGridTextColumn Header="{DynamicResource Ui047}" Binding="{Binding OutputName}" Width="2*"/><DataGridTextColumn Header="{DynamicResource Ui048}" Binding="{Binding Budget}" Width="210"/><DataGridTextColumn Header="{DynamicResource Ui049}" Binding="{Binding DisplayState}" Width="140"/><DataGridTextColumn Header="{DynamicResource Ui050}" Binding="{Binding DisplayDetail}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel>
<StackPanel Grid.Row="3" Margin="0,12,0,0">
  <Border x:Name="BatchProgressCard" Background="#F0F5FC" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel>
    <DockPanel><TextBlock x:Name="BatchElapsedText" DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="#344D69"/><TextBlock x:Name="BatchProgressText" FontWeight="SemiBold" Foreground="#173B65" TextWrapping="Wrap"/></DockPanel>
    <ProgressBar x:Name="BatchProgressBar" Height="6" Minimum="0" Maximum="1" Margin="0,5,0,5" Foreground="#2563A6" AutomationProperties.Name="{DynamicResource Ui072}"/>
    <TextBlock x:Name="BatchEtaText" Foreground="#526071" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Border Background="White" BorderBrush="#D8DFE7" BorderThickness="1" Padding="10" Margin="0,0,0,10"><StackPanel>
    <TextBlock x:Name="SelectedVideoText" Text="{DynamicResource Ui051}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6"/>
    <WrapPanel>
      <Button x:Name="EditPlanButton" Content="{DynamicResource Ui052}" Click="OnEditPlan" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="ResetPlanButton" Content="{DynamicResource Ui053}" Click="OnResetPlan" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="RetryButton" Content="{DynamicResource Ui054}" Click="OnRetry" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="RemoveButton" Content="{DynamicResource Ui055}" Click="OnRemove" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="PlayResultButton" Content="{DynamicResource Ui074}" Click="OnPlayResult" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="OpenResultButton" Content="{DynamicResource Ui030}" Click="OnOpenResult" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="CopyButton" Content="{DynamicResource Ui056}" Click="OnCopy" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
    </WrapPanel>
  </StackPanel></Border>
  <DockPanel Margin="0,0,0,8" LastChildFill="True">
<Button x:Name="FolderButton" DockPanel.Dock="Right" Content="{DynamicResource Ui043}" Click="OnFolder" Padding="10,6" Margin="8,0,0,0"/>
<Button x:Name="SourceFolderButton" DockPanel.Dock="Right" Content="{DynamicResource Ui044}" Click="OnSourceFolder" Padding="10,6" Margin="8,0,0,0"/>
<TextBlock x:Name="DestinationText" Text="{DynamicResource Ui045}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
</DockPanel>
  <TextBlock x:Name="BatchPreflightText" Visibility="Collapsed" Foreground="#173B65" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <TextBlock Text="{DynamicResource Ui071}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10"><TextBlock x:Name="Summary" Text="{DynamicResource Ui057}" TextWrapping="Wrap"/></ScrollViewer>
  <WrapPanel>
    <Button x:Name="StartButton" Content="{DynamicResource Ui058}" Click="OnStart" IsEnabled="False" Padding="18,9" MinWidth="164" Margin="0,0,8,4" FontWeight="SemiBold" Background="#167C77" Foreground="White" BorderBrush="#167C77"/>
    <Button x:Name="CancelButton" Content="{DynamicResource Ui029}" Click="OnCancel" IsEnabled="False" Padding="14,8" Margin="0,0,16,4"/>
    </WrapPanel><WrapPanel Margin="0,3,0,0"><Button x:Name="SaveDefaultsButton" Content="{DynamicResource Ui059}" Click="OnSaveDefaults" Padding="10,6" Margin="0,0,8,4"/>
    <Button x:Name="ResetDefaultsButton" Content="{DynamicResource Ui060}" Click="OnResetDefaults" Padding="10,6" Margin="0,0,8,4"/>
  </WrapPanel>
</StackPanel>
</Grid></Window>