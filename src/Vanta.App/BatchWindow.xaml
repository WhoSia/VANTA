<Window x:Class="Vanta.App.BatchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VANTA · Batch compression" Width="960" Height="590" MinWidth="660" MinHeight="420" WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" Background="#F3F5F8">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Batch compression" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Each video is encoded continuously and independently. Choose a destination or save beside each source." TextWrapping="Wrap" Foreground="#526071" Margin="0,4,0,14"/></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="AddButton" Content="Add videos…" Click="OnAdd" Padding="12,7" Margin="0,0,8,0"/><Button x:Name="ClearButton" Content="Clear" Click="OnClear" Padding="12,7" Margin="0,0,16,0"/><TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ProfileBox" Width="112" Margin="0,0,16,0" SelectionChanged="OnProfile"/><TextBlock Text="Parallel jobs" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ParallelBox" Width="60"/></WrapPanel>
<DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="True">
<Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Choose folder…" Click="OnFolder" Padding="10,6" Margin="8,0,0,0"/>
<Button x:Name="SourceFolderButton" DockPanel.Dock="Right" Content="Beside sources" Click="OnSourceFolder" Padding="10,6" Margin="8,0,0,0"/>
<TextBlock x:Name="DestinationText" Text="Output: beside each source" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
</DockPanel>
<DataGrid Grid.Row="3" x:Name="Queue" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" RowHeaderWidth="0" Background="White" AlternatingRowBackground="#F6F8FA">
<DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Paths}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding InputName}" Width="2*"/><DataGridTextColumn Header="Output" Binding="{Binding OutputName}" Width="2*"/><DataGridTextColumn Header="Plan / budget" Binding="{Binding Budget}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="140"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="Summary" Text="Add or drop videos to review the queue." TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button x:Name="StartButton" Content="Compress ready videos" Click="OnStart" IsEnabled="False" Padding="14,8" Margin="0,0,8,0"/><Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" Padding="14,8"/><Button x:Name="RemoveButton" Content="Remove selected" Click="OnRemove" Padding="14,8" Margin="8,0,0,0"/><Button x:Name="RetryButton" Content="Retry selected" Click="OnRetry" Padding="14,8" Margin="8,0,0,0"/><Button x:Name="OpenResultButton" Content="Open result folder" Click="OnOpenResult" Padding="14,8" Margin="8,0,0,0"/><Button x:Name="CopyButton" Content="Copy details" Click="OnCopy" Padding="14,8" Margin="8,0,0,0"/></WrapPanel></StackPanel>
</Grid></Window>