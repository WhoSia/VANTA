<Window x:Class="Vanta.App.BatchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Ui033}" Width="1040" Height="700" MinWidth="720" MinHeight="580" WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" Background="#F3F5F8">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="{DynamicResource Ui034}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Ui035}" TextWrapping="Wrap" Foreground="#526071" Margin="0,4,0,14"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,0,0,12"><WrapPanel Margin="0,0,0,10"><Button x:Name="AddButton" Content="{DynamicResource Ui036}" Click="OnAdd" Padding="12,7" Margin="0,0,8,0"/><Button x:Name="ClearButton" Content="{DynamicResource Ui037}" Click="OnClear" Padding="12,7" Margin="0,0,16,0"/><TextBlock Text="{DynamicResource Ui038}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#526071"/></WrapPanel><WrapPanel><TextBlock Text="{DynamicResource Ui039}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ProfileBox" Width="112" Margin="0,0,16,0" SelectionChanged="OnProfile"/><TextBlock Text="{DynamicResource Ui040}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="RecommendationBox" Width="165" Margin="0,0,16,0" SelectionChanged="OnProfile"/><TextBlock Text="{DynamicResource Ui070}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="SharedPresetBox" Width="112" Margin="0,0,16,0" ToolTip="{DynamicResource Ui068}" SelectionChanged="OnProfile"/><TextBlock Text="{DynamicResource Ui041}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ParallelBox" Width="60" Margin="0,0,12,0" SelectionChanged="OnResourceSettings"/><TextBlock Text="{DynamicResource Ui042}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="ThreadsBox" Width="155" SelectionChanged="OnResourceSettings"/></WrapPanel></StackPanel>

<DataGrid Grid.Row="2" x:Name="Queue" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OnQueueSelection" RowHeaderWidth="0" Background="White" AlternatingRowBackground="#F6F8FA">
<DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Paths}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Ui046}" Binding="{Binding InputName}" Width="2*"/><DataGridTextColumn Header="{DynamicResource Ui047}" Binding="{Binding OutputName}" Width="2*"/><DataGridTextColumn Header="{DynamicResource Ui048}" Binding="{Binding Budget}" Width="210"/><DataGridTextColumn Header="{DynamicResource Ui049}" Binding="{Binding DisplayState}" Width="140"/><DataGridTextColumn Header="{DynamicResource Ui050}" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3" Margin="0,12,0,0">
  <Border Background="White" BorderBrush="#D8DFE7" BorderThickness="1" Padding="10" Margin="0,0,0,10"><StackPanel>
    <TextBlock x:Name="SelectedVideoText" Text="{DynamicResource Ui051}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <WrapPanel>
      <Button x:Name="EditPlanButton" Content="{DynamicResource Ui052}" Click="OnEditPlan" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="ResetPlanButton" Content="{DynamicResource Ui053}" Click="OnResetPlan" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="RetryButton" Content="{DynamicResource Ui054}" Click="OnRetry" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="RemoveButton" Content="{DynamicResource Ui055}" Click="OnRemove" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="OpenResultButton" Content="{DynamicResource Ui030}" Click="OnOpenResult" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
      <Button x:Name="CopyButton" Content="{DynamicResource Ui056}" Click="OnCopy" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
    </WrapPanel>
  </StackPanel></Border>
  <DockPanel Margin="0,0,0,8" LastChildFill="True">
<Button x:Name="FolderButton" DockPanel.Dock="Right" Content="{DynamicResource Ui043}" Click="OnFolder" Padding="10,6" Margin="8,0,0,0"/>
<Button x:Name="SourceFolderButton" DockPanel.Dock="Right" Content="{DynamicResource Ui044}" Click="OnSourceFolder" Padding="10,6" Margin="8,0,0,0"/>
<TextBlock x:Name="DestinationText" Text="{DynamicResource Ui045}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
</DockPanel>
  <TextBlock Text="{DynamicResource Ui071}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <TextBlock x:Name="Summary" Text="{DynamicResource Ui057}" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <WrapPanel>
    <Button x:Name="StartButton" Content="{DynamicResource Ui058}" Click="OnStart" IsEnabled="False" Padding="18,9" MinWidth="164" Margin="0,0,8,4" FontWeight="SemiBold"/>
    <Button x:Name="CancelButton" Content="{DynamicResource Ui029}" Click="OnCancel" IsEnabled="False" Padding="14,8" Margin="0,0,16,4"/>
    </WrapPanel><WrapPanel Margin="0,3,0,0"><Button x:Name="SaveDefaultsButton" Content="{DynamicResource Ui059}" Click="OnSaveDefaults" Padding="10,6" Margin="0,0,8,4"/>
    <Button x:Name="ResetDefaultsButton" Content="{DynamicResource Ui060}" Click="OnResetDefaults" Padding="10,6" Margin="0,0,8,4"/>
  </WrapPanel>
</StackPanel>
</Grid></Window>