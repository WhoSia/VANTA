<Window x:Class="Vanta.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VANTA — 0.3.0 preview" Width="790" Height="760" MinWidth="560" MinHeight="480" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" Background="#F3F5F8">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="Padding" Value="6"/></Style>
<Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="Padding" Value="6"/></Style>
</Window.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<TextBlock Text="VANTA" FontSize="30" FontWeight="SemiBold"/>
<TextBlock Text="Video compression · 0.3.0 development preview" Foreground="#526071" Margin="0,2,0,16"/>
<Border Background="White" CornerRadius="8" Padding="16"><StackPanel>
<WrapPanel><Button x:Name="OpenButton" Content="Open video or drop here" Click="OnOpen"/><Button x:Name="BatchButton" Content="Batch compression…" Click="OnBatch"/><Button x:Name="DiagnosticsButton" Content="Check hardware encoders…" Click="OnDiagnostics"/></WrapPanel>
<TextBlock x:Name="Source" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></Border>
<TextBlock Text="Suggested plans" FontWeight="SemiBold" Margin="0,16,0,6"/>
<TextBlock Text="Recommendation codec (changing this rebuilds the plans and resets manual settings)" TextWrapping="Wrap" Foreground="#526071"/>
<ComboBox x:Name="RecommendationBox" MinWidth="180" MaxWidth="260" HorizontalAlignment="Left" IsEnabled="False" SelectionChanged="OnRecommendation"/>
<TextBlock Text="Profiles are bitrate-budget tiers, not measured quality guarantees." TextWrapping="Wrap" Foreground="#526071" Margin="0,0,0,6"/>
<ListBox x:Name="Plans" DisplayMemberPath="Label" SelectionChanged="OnPlan" MinHeight="72" MaxHeight="140"/>
<TextBlock Text="Encoding settings" FontWeight="SemiBold" Margin="0,16,0,8"/>
<Border Background="White" CornerRadius="8" Padding="16"><StackPanel x:Name="Editor" IsEnabled="False">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Video codec"/><ComboBox x:Name="CodecBox" SelectionChanged="OnSettings"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Preset"/><ComboBox x:Name="PresetBox" SelectionChanged="OnSettings"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Height (pixels, even)"/><TextBox x:Name="HeightBox" TextChanged="OnSettings"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Video bitrate (kbps)"/><TextBox x:Name="RateBox" TextChanged="OnSettings"/></StackPanel></Grid>
<TextBlock Text="Target size (MB, approximate)"/><DockPanel><Button DockPanel.Dock="Right" Content="Apply target" Click="OnTarget"/><TextBox x:Name="TargetBox" Margin="0,4,12,4"/></DockPanel>
<TextBlock Text="Encoder thread budget (optional)"/>
<ComboBox x:Name="ThreadsBox" MaxWidth="230" HorizontalAlignment="Left" MinWidth="180"/>
<TextBlock Text="Auto is the default. This is an encoder thread request, not a CPU usage limit; decoding and codec worker pools may use additional threads." Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,6"/>
<CheckBox x:Name="SplitBox" Content="Experimental: split video into two parallel parts" Margin="0,10,0,4"/>
<TextBlock Text="Optional, H.264 MP4 CFR only, original dimensions. May be slower or change quality; strict validation, no output on failure." Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,6"/>
<TextBlock Text="MP4 · source frame timing · AAC copy · single pass" Foreground="#526071" Margin="0,8,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="Estimate" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="Evidence" Foreground="#526071" Margin="0,4,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
<WrapPanel Margin="0,16,0,0"><Button x:Name="EncodeButton" Content="Compress to new file" IsEnabled="False" Click="OnEncode"/><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="OnCancel"/><Button x:Name="ResultFolderButton" Content="Open result folder" IsEnabled="False" Click="OnResultFolder"/><Button x:Name="CopyResultButton" Content="Copy result" IsEnabled="False" Click="OnCopyResult"/></WrapPanel>
<TextBlock x:Name="ResultPath" TextWrapping="Wrap" Foreground="#526071" Margin="0,6,0,0"/><ProgressBar x:Name="BusyBar" Height="5" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
<TextBlock x:Name="Status" Text="Open an 8-bit SDR video with AAC audio or no audio." TextWrapping="Wrap" Foreground="#526071" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></Window>