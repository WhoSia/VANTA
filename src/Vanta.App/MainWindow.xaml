<Window x:Class="Vanta.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Ui001}" Width="790" Height="760" MinWidth="560" MinHeight="480" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" Background="#F3F5F8">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="Padding" Value="6"/></Style>
<Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="Padding" Value="6"/></Style>
</Window.Resources>
<DockPanel LastChildFill="True"><Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D8DFE7" BorderThickness="0,1,0,0" Padding="20,12"><StackPanel>
<TextBlock Text="{DynamicResource Ui069}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,4"/>
<WrapPanel Margin="0,4,0,0"><Button x:Name="EncodeButton" Content="{DynamicResource Ui028}" IsEnabled="False" Click="OnEncode" FontWeight="SemiBold" MinHeight="32"/><Button x:Name="CancelButton" Content="{DynamicResource Ui029}" IsEnabled="False" Click="OnCancel"/><Button x:Name="ResultFolderButton" Content="{DynamicResource Ui030}" IsEnabled="False" Click="OnResultFolder"/><Button x:Name="CopyResultButton" Content="{DynamicResource Ui031}" IsEnabled="False" Click="OnCopyResult"/></WrapPanel>
<TextBlock x:Name="ResultPath" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#526071" Margin="0,6,0,0"/><ProgressBar x:Name="BusyBar" Height="5" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
<ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0"><TextBlock x:Name="Status" Text="{DynamicResource Ui032}" TextWrapping="Wrap" Foreground="#526071"/></ScrollViewer>

</StackPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<DockPanel LastChildFill="True"><ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="104" SelectionChanged="OnLanguage" AutomationProperties.Name="Language / 언어" Margin="0,0,0,0"><ComboBoxItem Content="English"/><ComboBoxItem Content="한국어"/></ComboBox><TextBlock Text="VANTA" FontSize="30" FontWeight="SemiBold"/></DockPanel>
<TextBlock Text="{DynamicResource Ui002}" Foreground="#526071" Margin="0,2,0,16"/>
<Border Background="White" CornerRadius="8" Padding="16"><StackPanel>
<WrapPanel><Button x:Name="OpenButton" Content="{DynamicResource Ui003}" Click="OnOpen"/><Button x:Name="BatchButton" Content="{DynamicResource Ui004}" Click="OnBatch"/><Button x:Name="DiagnosticsButton" Content="{DynamicResource Ui005}" Click="OnDiagnostics"/></WrapPanel>
<TextBlock x:Name="Source" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></Border>
<TextBlock Text="{DynamicResource Ui006}" FontWeight="SemiBold" Margin="0,16,0,6"/>
<TextBlock Text="{DynamicResource Ui007}" TextWrapping="Wrap" Foreground="#526071"/>
<ComboBox x:Name="RecommendationBox" MinWidth="180" MaxWidth="260" HorizontalAlignment="Left" IsEnabled="False" SelectionChanged="OnRecommendation"/>
<TextBlock Text="{DynamicResource Ui008}" TextWrapping="Wrap" Foreground="#526071" Margin="0,0,0,6"/>
<ListBox x:Name="Plans" SelectionChanged="OnPlan" MinHeight="92" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#D8DFE7"/></Style></ListBox.ItemContainerStyle>
  <ListBox.ItemTemplate><DataTemplate><StackPanel>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Size}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Settings}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Savings}" FontSize="12" Foreground="#526071" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<TextBlock Text="{DynamicResource Ui009}" FontWeight="SemiBold" Margin="0,16,0,8"/>
<Border Background="White" CornerRadius="8" Padding="16"><StackPanel x:Name="Editor" IsEnabled="False">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Ui010}"/><ComboBox x:Name="CodecBox" SelectionChanged="OnSettings"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Ui011}"/><ComboBox x:Name="PresetBox" SelectionChanged="OnSettings" ToolTip="{DynamicResource Ui068}"/></StackPanel></Grid>
<TextBlock Text="{DynamicResource Ui068}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Ui012}"/><TextBlock Text="{DynamicResource Ui013}" FontSize="12" Foreground="#526071"/><ComboBox x:Name="HeightChoicesBox" ToolTip="{DynamicResource Ui014}" SelectionChanged="OnQuickHeight" Margin="0,4,12,6"/><TextBlock Text="{DynamicResource Ui015}" FontSize="12" Foreground="#526071"/><TextBox x:Name="HeightBox" TextChanged="OnSettings"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Ui016}"/><TextBlock Text="{DynamicResource Ui013}" FontSize="12" Foreground="#526071"/><ComboBox x:Name="RateChoicesBox" ToolTip="{DynamicResource Ui017}" SelectionChanged="OnQuickRate" Margin="0,4,12,6"/><TextBlock Text="{DynamicResource Ui018}" FontSize="12" Foreground="#526071"/><TextBox x:Name="RateBox" TextChanged="OnSettings"/></StackPanel></Grid>
<Button x:Name="MoreCompressionButton" Content="{DynamicResource Ui019}" IsEnabled="False" Click="OnMoreCompression" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="{DynamicResource Ui020}"/><TextBlock Text="{DynamicResource Ui021}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Ui022}" Click="OnTarget"/><TextBox x:Name="TargetBox" Margin="0,4,12,4"/></DockPanel>
<TextBlock Text="{DynamicResource Ui023}"/>
<ComboBox x:Name="ThreadsBox" MaxWidth="230" HorizontalAlignment="Left" MinWidth="180"/>
<TextBlock Text="{DynamicResource Ui024}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,6"/>
<CheckBox x:Name="SplitBox" Content="{DynamicResource Ui025}" Margin="0,10,0,4"/>
<TextBlock Text="{DynamicResource Ui026}" Foreground="#526071" TextWrapping="Wrap" Margin="0,0,0,6"/>
<TextBlock Text="{DynamicResource Ui027}" Foreground="#526071" Margin="0,8,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="Estimate" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="Evidence" Foreground="#526071" Margin="0,4,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></DockPanel></Window>